# Copy to .env locally if you need to regenerate GPU caches.
# Never commit a real .env file.

HF_TOKEN=<your-huggingface-token>
RUNPOD_API_KEY=<optional-runpod-api-key>
RUNPOD_MAX_DOLLARS=25
RUNPOD_MAX_GPU_HOURS=2

# Optional generic SSH settings for a GPU host you control.
GPU_SSH_HOST=<public-host>
GPU_SSH_PORT=22
GPU_SSH_USER=<user>
GPU_SSH_IDENTITY_FILE=<path-to-private-key-outside-repo>
